{
  "name": "dsh-cache-miss",
  "version": "0.2.0",
  "description": "DSH web plugin: one yellow line per prompt-cache miss — idle gap, re-billed tokens, approximate RMB cost from the models.dev price list, and TTFT, placed beside the Turn that paid for it.",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "README.i18n.yaml",
    "cache-miss.png"
  ],
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json && tsdown",
    "prepack": "pnpm build",
    "pack:latest": "pnpm pack && node scripts/pack-latest.mjs",
    "prices": "node scripts/fetch-prices.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-modules": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6 <0.3.0-0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "rimraf": "^5.0.5",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "wefio",
  "repository": {
    "type": "git",
    "url": "https://github.com/wefio/dsh-cache-miss.git"
  },
  "bugs": {
    "url": "https://github.com/wefio/dsh-cache-miss/issues"
  },
  "homepage": "https://github.com/wefio/dsh-cache-miss#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-cache",
    "cache-hit",
    "billing",
    "cost"
  ],
  "license": "MIT"
}



